    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from dataclasses import dataclass\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"@dataclass(frozen=True)\\n\",\n",
    "    \"class PrepareBaseModelConfig:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Prepare Base Model Configurations\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    root_dir: Path\\n\",\n",
    "    \"    base_model_path: Path\\n\",\n",
    "    \"    updated_base_model_path: Path\\n\",\n",
    "    \"    params_image_size: list\\n\",\n",
    "    \"    params_learning_rate: float\\n\",\n",
    "    \"    params_include_top: bool\\n\",\n",
    "    \"    params_weights: str\\n\",\n",
    "    \"    params_classes: int\"\n",
    "   ],\n",
    "   \"id\": \"d3723840c44f3749\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-22T17:06:36.731918Z\",\n",
    "     \"start_time\": \"2026-01-22T17:06:36.607130Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from src.cnnClassifier.constants import *\\n\",\n",
    "    \"from src.cnnClassifier.utils.common import read_yaml, create_directories\"\n",
    "   ],\n",
    "   \"id\": \"77997e5eae06037d\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-22T17:06:36.743013Z\",\n",
    "     \"start_time\": \"2026-01-22T17:06:36.740577Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"class ConfigurationManager:\\n\",\n",
    "    \"    def __init__(self, config_filepath=CONFIG_FILE_PATH, params_filepath=PARAMS_FILE_PATH):\\n\",\n",
    "    \"        self.config = read_yaml(config_filepath)\\n\",\n",
    "    \"        self.params = read_yaml(params_filepath)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        create_directories([self.config.artifacts_root])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_prepare_base_model_config(self) -> PrepareBaseModelConfig:\\n\",\n",
    "    \"        config = self.config.prepare_base_model\\n\",\n",
    "    \"        params = self.params\\n\",\n",
    "    \"\\n\",\n",
    "    \"        create_directories([config.root_dir])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        prepare_base_model_config = PrepareBaseModelConfig(\\n\",\n",
    "    \"            root_dir=Path(config.root_dir),\\n\",\n",
    "    \"            base_model_path=Path(config.base_model_path),\\n\",\n",
    "    \"            updated_base_model_path=Path(config.updated_base_model_path),\\n\",\n",
    "    \"            params_image_size=params.IMAGE_SIZE,\\n\",\n",
    "    \"            params_include_top=params.INCLUDE_TOP,\\n\",\n",
    "    \"            params_classes=params.CLASSES,\\n\",\n",
    "    \"            params_weights=params.WEIGHTS,\\n\",\n",
    "    \"            params_learning_rate=params.LEARNING_RATE,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return prepare_base_model_config\"\n",
    "   ],\n",
    "   \"id\": \"a2d12abe8766ad1f\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-22T17:06:39.763712Z\",\n",
    "     \"start_time\": \"2026-01-22T17:06:36.745234Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import urllib.request as request\\n\",\n",
    "    \"from zipfile import ZipFile\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"from torchvision import models\"\n",
    "   ],\n",
    "   \"id\": \"a4ddca7b91015c48\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-22T17:06:39.774150Z\",\n",
    "     \"start_time\": \"2026-01-22T17:06:39.770286Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"from torchvision import models\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"class PrepareBaseModel:\\n\",\n",
    "    \"    def __init__(self, config: PrepareBaseModelConfig):\\n\",\n",
    "    \"        self.config = config\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_base_model(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Load the VGG16 model from torchvision.models with pretrained weights\\n\",\n",
    "    \"        :return: base_model\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # Load pretrained VGG16\\n\",\n",
    "    \"        weights = models.VGG16_Weights.IMAGENET1K_V1 if self.config.params_weights == \\\"imagenet\\\" else None\\n\",\n",
    "    \"        base_model = models.vgg16(weights=weights)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.save_model(model=base_model, model_path=self.config.base_model_path)\\n\",\n",
    "    \"        return base_model\\n\",\n",
    "    \"\\n\",\n",
    "    \"    @staticmethod\\n\",\n",
    "    \"    def _prepare_full_model(base_model, config: PrepareBaseModelConfig):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Prepare the full model by modifying the classifier for custom classes\\n\",\n",
    "    \"        :param base_model: Pretrained base model\\n\",\n",
    "    \"        :param config: PrepareBaseModelConfig\\n\",\n",
    "    \"        :return: full_model\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # Freeze all parameters in the feature extractor\\n\",\n",
    "    \"        for param in base_model.features.parameters():\\n\",\n",
    "    \"            param.requires_grad = False\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if not config.params_include_top:\\n\",\n",
    "    \"            # Replace the entire classifier with a custom one\\n\",\n",
    "    \"            base_model.classifier = nn.Sequential(\\n\",\n",
    "    \"                nn.Linear(512 * 7 * 7, 4096),\\n\",\n",
    "    \"                nn.ReLU(inplace=True),\\n\",\n",
    "    \"                nn.Dropout(p=0.5),\\n\",\n",
    "    \"                nn.Linear(4096, 4096),\\n\",\n",
    "    \"                nn.ReLU(inplace=True),\\n\",\n",
    "    \"                nn.Dropout(p=0.5),\\n\",\n",
    "    \"                nn.Linear(4096, config.params_classes)\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            # Only replace the final layer\\n\",\n",
    "    \"            num_features = base_model.classifier[6].in_features\\n\",\n",
    "    \"            base_model.classifier[6] = nn.Linear(num_features, config.params_classes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return base_model\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def update_base_model(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Update the base model by adding custom layers on top of it\\n\",\n",
    "    \"        :return: full_model\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        base_model = torch.load(self.config.base_model_path, weights_only=False)\\n\",\n",
    "    \"        full_model = self._prepare_full_model(base_model=base_model, config=self.config)\\n\",\n",
    "    \"        self.save_model(model=full_model, model_path=self.config.updated_base_model_path)\\n\",\n",
    "    \"        return full_model\\n\",\n",
    "    \"\\n\",\n",
    "    \"    @staticmethod\\n\",\n",
    "    \"    def save_model(model, model_path: Path):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Save the model to the specified path\\n\",\n",
    "    \"        :param model: PyTorch model\\n\",\n",
    "    \"        :param model_path: Path to save the model\\n\",\n",
    "    \"        :return: None\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        model_path.parent.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"        torch.save(model.state_dict(), model_path)\"\n",
    "   ],\n",
    "   \"id\": \"5ab530ecb145c484\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-22T17:07:23.357418Z\",\n",
    "     \"start_time\": \"2026-01-22T17:06:39.779142Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"try:\\n\",\n",
    "    \"    config = ConfigurationManager()\\n\",\n",
    "    \"    prepare_base_model_config = config.get_prepare_base_model_config()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    prepare_base_model = PrepareBaseModel(config=prepare_base_model_config)\\n\",\n",
    "    \"    prepare_base_model.get_base_model()\\n\",\n",
    "    \"    prepare_base_model.update_base_model()\\n\",\n",
    "    \"except Exception as e:\\n\",\n",
    "    \"    raise e\"\n",
    "   ],\n",
